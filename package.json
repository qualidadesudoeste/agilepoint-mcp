{
  "name": "agilepoint-apf-mcp",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "MCP universal para usuários operarem telas autorizadas do AgilePoint via IA",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test.mjs && node scripts/test-elicitation.mjs && node scripts/test-installer.mjs && node scripts/test-apf-kit.mjs && node scripts/test-apf-workbook.mjs && node scripts/test-apf-integration.mjs",
    "test:discovery": "npm run build && node scripts/test-network-discovery.mjs",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-release.ps1",
    "approve": "node scripts/approve.mjs",
    "discover:endpoints": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/descobrir-endpoints-interativo.ps1",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "1.2.0",
    "fflate": "0.8.3",
    "json5": "2.2.3",
    "read-excel-file": "9.3.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
